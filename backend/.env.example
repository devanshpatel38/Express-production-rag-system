# --- App ---
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:3000

IDLE_TIMEOUT_SECONDS=300

# --- LLM (pick one; gemini has the more generous free tier) ---
LLM_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Embeddings ---
# 'local' uses sentence-transformers (no key required, ~80MB model download on first run).
EMBEDDING_BACKEND=local

# --- Reranker (optional but recommended) ---
RERANKER_ENABLED=true
COHERE_API_KEY=

# --- Retrieval knobs ---
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K_DENSE=15
TOP_K_BM25=15
TOP_K_RERANK=5
HYBRID_ALPHA=0.5

# --- Self-healing RAG ---
# Master switch. Set to false to fall back to the naive retrieve->rerank->generate path.
SELF_HEALING_ENABLED=true
# Off-topic queries get short-circuited before retrieval if true.
ADAPTIVE_ROUTING_ENABLED=true
# Hypothetical Document Embeddings - adds one LLM call before retrieval; off by default.
# Clients can also opt-in per-request via use_hyde=true.
HYDE_ENABLED=false
# LLM grades each retrieved chunk for relevance; weak ones get filtered.
RETRIEVAL_GRADING_ENABLED=true
GRADING_KEEP_THRESHOLD=0.3
GRADING_MIN_KEEP_RATIO=0.5
# Post-generation faithfulness check (the "is this answer grounded?" gate).
FAITHFULNESS_CHECK_ENABLED=true
FAITHFULNESS_THRESHOLD=0.6
# Bounded retry budget for the self-healing loop.
MAX_HEALING_ATTEMPTS=2

# --- Semantic cache (in-memory) ---
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_SIZE=256
