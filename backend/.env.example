# --- App ---
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:3000

IDLE_TIMEOUT_SECONDS=300

# --- LLM (pick one; gemini has the more generous free tier) ---
LLM_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Embeddings ---
# 'local' uses sentence-transformers (no key required, ~80MB model download on first run).
EMBEDDING_BACKEND=local

# --- Reranker (optional but recommended) ---
RERANKER_ENABLED=true
COHERE_API_KEY=

# --- Retrieval knobs ---
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K_DENSE=15
TOP_K_BM25=15
TOP_K_RERANK=5
HYBRID_ALPHA=0.5
